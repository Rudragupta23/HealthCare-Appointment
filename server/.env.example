# CORE APP
NODE_ENV=development
PORT=5000

# Where the React app runs 
CLIENT_URL=http://localhost:5173

# Public URL of THIS server
SERVER_URL=http://localhost:5000

# DATABASE
MONGODB_URI=mongodb://127.0.0.1:27017/healthcare_appointments

# AUTH
JWT_SECRET=replace_me_with_a_long_random_string
JWT_EXPIRES_IN=7d
BCRYPT_ROUNDS=10

# SEED ADMIN  
ADMIN_NAME=Clinic Admin
ADMIN_EMAIL=admin@clinic.test
ADMIN_PASSWORD=Admin@12345

# BOOKING RULES
SLOT_HOLD_MINUTES=10
APPOINTMENT_REMINDER_LEAD_MINUTES=60
CLINIC_TIMEZONE=Asia/Kolkata

# LLM  
LLM_PROVIDER=none
LLM_API_KEY=
LLM_MODEL=claude-sonnet-4-5
LLM_TIMEOUT_MS=20000
LLM_MAX_RETRIES=2

# EMAIL
EMAIL_PROVIDER=console
EMAIL_FROM="City Clinic <no-reply@clinic.test>"
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SENDGRID_API_KEY=
EMAIL_MAX_ATTEMPTS=5

# GOOGLE CALENDAR (OAuth 2.0)
GOOGLE_CALENDAR_ENABLED=true
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:5000/api/calendar/oauth/callback

# BACKGROUND JOBS
ENABLE_JOBS=true
