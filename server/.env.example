# ─────────────────────────────────────────────────────────────
# CORE APP
# ─────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=5000
# Where the React app runs (used for CORS + links inside emails)
CLIENT_URL=http://localhost:5173
# Public URL of THIS server (used to build the Google OAuth redirect)
SERVER_URL=http://localhost:5000

# ─────────────────────────────────────────────────────────────
# DATABASE  (MongoDB)
# Local:  mongodb://127.0.0.1:27017/healthcare_appointments
# Atlas:  mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net/healthcare_appointments?retryWrites=true&w=majority
# ─────────────────────────────────────────────────────────────
MONGODB_URI=mongodb://127.0.0.1:27017/healthcare_appointments

# ─────────────────────────────────────────────────────────────
# AUTH
# JWT_SECRET: any long random string. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# ─────────────────────────────────────────────────────────────
JWT_SECRET=replace_me_with_a_long_random_string
JWT_EXPIRES_IN=7d
BCRYPT_ROUNDS=10

# ─────────────────────────────────────────────────────────────
# SEED ADMIN  (created by `npm run seed`)
# ─────────────────────────────────────────────────────────────
ADMIN_NAME=Clinic Admin
ADMIN_EMAIL=admin@clinic.test
ADMIN_PASSWORD=Admin@12345

# ─────────────────────────────────────────────────────────────
# BOOKING RULES
# SLOT_HOLD_MINUTES  - how long a slot stays reserved while the
#                      patient fills the symptom form
# ─────────────────────────────────────────────────────────────
SLOT_HOLD_MINUTES=10
APPOINTMENT_REMINDER_LEAD_MINUTES=60
CLINIC_TIMEZONE=Asia/Kolkata

# ─────────────────────────────────────────────────────────────
# LLM  (pre-visit + post-visit summaries)
# LLM_PROVIDER = anthropic | openai | gemini | none
#   anthropic -> key from https://console.anthropic.com  (starts sk-ant-)
#   openai    -> key from https://platform.openai.com/api-keys (starts sk-)
#   gemini    -> key from https://aistudio.google.com/app/apikey
#   none      -> summaries fall back to the built-in rule-based generator
# ─────────────────────────────────────────────────────────────
LLM_PROVIDER=none
LLM_API_KEY=
LLM_MODEL=claude-sonnet-4-5
LLM_TIMEOUT_MS=20000
LLM_MAX_RETRIES=2

# ─────────────────────────────────────────────────────────────
# EMAIL
# EMAIL_PROVIDER = smtp | sendgrid | console
#   console  -> emails are printed to the terminal (no setup, great for demos)
#   smtp     -> Gmail: turn on 2-Step Verification, then create an App Password
#               (https://myaccount.google.com/apppasswords) and paste the
#               16-character password into SMTP_PASS
#   sendgrid -> API key from https://app.sendgrid.com/settings/api_keys
# ─────────────────────────────────────────────────────────────
EMAIL_PROVIDER=console
EMAIL_FROM="City Clinic <no-reply@clinic.test>"
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SENDGRID_API_KEY=
EMAIL_MAX_ATTEMPTS=5

# ─────────────────────────────────────────────────────────────
# GOOGLE CALENDAR (OAuth 2.0)
# 1. https://console.cloud.google.com -> new project
# 2. APIs & Services -> Library -> enable "Google Calendar API"
# 3. OAuth consent screen -> External -> add yourself as a Test user
#    -> scope .../auth/calendar.events
# 4. Credentials -> Create credentials -> OAuth client ID -> Web application
# 5. Authorised redirect URI must match GOOGLE_REDIRECT_URI exactly
# ─────────────────────────────────────────────────────────────
GOOGLE_CALENDAR_ENABLED=true
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:5000/api/calendar/oauth/callback

# ─────────────────────────────────────────────────────────────
# BACKGROUND JOBS
# ─────────────────────────────────────────────────────────────
ENABLE_JOBS=true
